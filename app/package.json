{
  "name": "evaggelou-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "images:stock": "node scripts/fetch-stock-images.mjs",
    "test:club": "node scripts/run-club-tests.mjs",
    "test:club:mutation": "node scripts/run-club-mutations.mjs",
    "build:staff": "vite build --config vite.staff.config.ts",
    "build:customer": "vite build --config vite.customer.config.ts",
    "package:club-plugin": "node scripts/package-club-plugin.mjs",
    "check:isolated-build": "node scripts/check-isolated-build.mjs",
    "recovery:preview": "vite --host 127.0.0.1 --open /recovery-preview.html",
    "counter:preview": "vite --host 127.0.0.1 --open /counter-preview.html",
    "customer:preview": "vite --host 127.0.0.1 --open /customer-preview.html"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/node": "^12.0.1",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.79.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
