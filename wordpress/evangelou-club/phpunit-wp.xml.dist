<?xml version="1.0" encoding="UTF-8"?>
<!--
  REAL WordPress integration tests (wp-phpunit, disposable DB).
  Run twice: EVC_TEST_STAFF_FLAG=disabled (wp-common + wp-disabled) and
  EVC_TEST_STAFF_FLAG=enabled (wp-common + wp-enabled).
  STAGE-01: EVC_TEST_STAFF_FLAG=disabled EVC_TEST_CUSTOMER_FLAG=enabled (wp-customer).
  STAGE-03D: the wp-commerce-on suite also sets EVC_TEST_WC_COMPLETION_FLAG=enabled.
  STAGE-04A: wp-migrations runs with EVC_TEST_STAFF_FLAG=disabled EVC_TEST_CLUB_MIGRATIONS_FLAG=enabled.
  STAGE-05A: wp-redemption runs with EVC_TEST_STAFF_FLAG=enabled EVC_TEST_CLUB_REDEMPTION_FLAG=enabled;
  wp-commerce-redeem adds EVC_TEST_COMMERCE_PLUGINS (CI commerce job).
  STAGE-06: wp-fluentcrm runs with EVC_TEST_STAFF_FLAG=disabled EVC_TEST_FLUENTCRM_FLAG=enabled (fake FluentCRM API).
  STAGE-02: same flags + EVC_TEST_COMMERCE_PLUGINS=<dir of pinned WooCommerce/PMPro/add-on> (wp-commerce).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/wordpress/bootstrap.php"
         colors="true"
         cacheResult="false"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="wp-common">
            <directory>tests/wordpress/common</directory>
        </testsuite>
        <testsuite name="wp-enabled">
            <directory>tests/wordpress/enabled</directory>
        </testsuite>
        <testsuite name="wp-disabled">
            <directory>tests/wordpress/disabled</directory>
        </testsuite>
        <testsuite name="wp-customer">
            <directory>tests/wordpress/customer</directory>
        </testsuite>
        <testsuite name="wp-commerce">
            <directory>tests/wordpress/commerce</directory>
        </testsuite>
        <!-- STAGE-03D: the same site with EVC_CLUB_WC_COMPLETION_ENABLED=true (EVC_TEST_WC_COMPLETION_FLAG=enabled). -->
        <testsuite name="wp-commerce-on">
            <directory>tests/wordpress/commerce-on</directory>
        </testsuite>
        <!-- STAGE-04A: Club-DB migrations page / CLI with EVC_CLUB_MIGRATIONS_ENABLED=true (EVC_TEST_CLUB_MIGRATIONS_FLAG=enabled). -->
        <testsuite name="wp-migrations">
            <directory>tests/wordpress/migrations</directory>
        </testsuite>
        <!-- STAGE-05A: staff flag ON + EVC_CLUB_REDEMPTION_SOURCE='club_db_v1' (EVC_TEST_CLUB_REDEMPTION_FLAG=enabled), no commerce constants. -->
        <testsuite name="wp-redemption">
            <directory>tests/wordpress/redemption</directory>
        </testsuite>
        <!-- STAGE-05A: the same with the real WooCommerce / PMPro site, recorded provenance and the Club DB (CI commerce job). -->
        <testsuite name="wp-commerce-redeem">
            <directory>tests/wordpress/commerce-redeem</directory>
        </testsuite>
        <!-- STAGE-06: FluentCRM tag sync constant ON with the TEST-ONLY fake FluentCRM API (EVC_TEST_FLUENTCRM_FLAG=enabled). -->
        <testsuite name="wp-fluentcrm">
            <directory>tests/wordpress/fluentcrm</directory>
        </testsuite>
        <!-- STAGE-06 round 2: the same over the REAL commerce site (EVC_TEST_COMMERCE_PLUGINS, CI commerce job). -->
        <testsuite name="wp-commerce-fluentcrm">
            <directory>tests/wordpress/commerce-fluentcrm</directory>
        </testsuite>
        <!-- STAGE-07: in-store onboarding ON (EVC_TEST_ONBOARDING_FLAG=enabled + EVC_TEST_CUSTOMER_FLAG=enabled), no commerce plugins. -->
        <testsuite name="wp-onboarding">
            <directory>tests/wordpress/onboarding</directory>
        </testsuite>
        <!-- STAGE-07: the same over the REAL commerce site (EVC_TEST_COMMERCE_PLUGINS, CI commerce job). -->
        <testsuite name="wp-commerce-onboarding">
            <directory>tests/wordpress/commerce-onboarding</directory>
        </testsuite>
    </testsuites>
</phpunit>
