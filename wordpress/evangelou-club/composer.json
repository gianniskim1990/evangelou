{
    "name": "evangelou/evangelou-club",
    "description": "Evangelou Club WordPress plugin. Composer is used for development/test tooling only; the plugin has no runtime Composer dependencies.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*"
    },
    "require-dev": {
        "johnpbloch/wordpress-core": "7.1.*",
        "phpunit/phpunit": "^9.6.22",
        "wp-phpunit/wp-phpunit": "7.1.*",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {},
        "platform": {
            "php": "7.4.33"
        }
    }
}
